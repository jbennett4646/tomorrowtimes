<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} | {% endif %}The Tomorrow Times</title>
{%- set isArticle = dateline %}
{%- set pageTitle = (title if isArticle else (title + ' | ' + site.name)) if title else site.name %}
{%- set pageDesc = summary or (content | excerpt if isArticle) or 'Tomorrow’s news, delivered today. Additional fees may apply.' %}
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:type" content="{{ 'article' if isArticle else 'website' }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
{%- if isArticle and image %}
<meta property="og:image" content="{{ site.url }}{{ image }}">
<meta property="og:image:alt" content="{{ image_alt or pageTitle }}">
{%- else %}
<meta property="og:image" content="{{ site.url }}/og/{{ page.fileSlug if isArticle else 'home' }}.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ (pageTitle + ', from The Tomorrow Times') if isArticle else 'The Tomorrow Times: Tomorrow’s news, delivered today.' }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Arvo:wght@400;700&display=swap">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
<link rel="icon" href="{{ '/icons/logo-clock.svg' | url }}" type="image/svg+xml">
</head>
<body>
<div class="wrap">
<header class="mast">
<a href="{{ '/' | url }}"><img src="{{ '/icons/logo-clock.svg' | url }}" width="86" height="86" alt=""></a>
<div><a href="{{ '/' | url }}"><p class="site-name">The Tomorrow Times</p></a><p>Tomorrow’s news, delivered today. Additional fees may apply.</p></div>
</header>
<nav class="nav" aria-label="Sections">
<a href="{{ '/' | url }}">Home</a>
{%- for s in sections %}<a href="{{ ('/' + s.key + '/') | url }}">{{ s.name }}</a>{% endfor %}
</nav>
<div class="cols">
{%- if not hideLeftRail %}
<aside class="left">
<div class="box"><h3>Sections</h3>
{%- for s in sections %}
<a class="sec" href="{{ ('/' + s.key + '/') | url }}"><img src="{{ ('/icons/' + s.key + '.svg') | url }}" alt="">{{ s.name }}</a>
{%- endfor %}
</div>
<div class="box"><h3>Today’s Mood</h3><div class="mood" id="mood"><img src="{{ '/icons/mood-concerned.svg' | url }}" width="90" height="60" alt=""><p>Concerned</p></div></div>
<script>
// One mood per calendar day, the same for every visitor, never the same two days in a row.
(function () {
  var moods = {{ moods | dump | safe }};
  var base = "{{ '/icons/' | url }}";
  function hash(s) { var h = 2166136261; for (var i = 0; i < s.length; i++) { h ^= s.charCodeAt(i); h = Math.imul(h, 16777619); } return h >>> 0; }
  function raw(d) { return hash(d.getFullYear() + "-" + (d.getMonth() + 1) + "-" + d.getDate()) % moods.length; }
  var today = new Date(); today.setHours(12, 0, 0, 0);
  var yesterday = new Date(today); yesterday.setDate(today.getDate() - 1);
  var i = raw(today);
  if (i === raw(yesterday)) i = (i + 1) % moods.length;
  var box = document.getElementById("mood");
  box.querySelector("img").src = base + "mood-" + moods[i].key + ".svg";
  box.querySelector("p").textContent = moods[i].name;
})();
</script>
</aside>
{%- endif %}
<main class="main">
{{ content | safe }}
</main>
<aside class="right">
<div class="box mauve"><h3>Get Tomorrow Today</h3><div class="box-body signup">
<form action="#" onsubmit="return false;">
<label for="email">Email address</label>
<input id="email" type="email" placeholder="your@email.com" autocomplete="email">
<button type="submit">Sign Me Up!</button>
</form>
</div></div>
</aside>
</div>
<footer class="foot">The Tomorrow Times is satire. All companies, people, and quotes are invented.</footer>
</div>
</body>
</html>
