---
layout: layouts/base.njk
---
{%- set lead = collections.articles | cover %}
{%- if lead %}
<article class="lead">
{%- if lead.data.image %}<a href="{{ lead.url | url }}"><img class="lead-img" src="{{ lead.data.image | url }}" alt="{{ lead.data.image_alt }}"></a>{% endif %}
<div class="lead-body"><span class="kick">COVER STORY</span>
<h2><a href="{{ lead.url | url }}">{{ lead.data.title }}</a></h2>
{%- if lead.data.summary %}<p>{{ lead.data.summary }}</p>{% endif %}
</div>
</article>
{%- endif %}
<section class="list"><h3>More Headlines</h3>
{%- for a in collections.articles | without(lead) | first(15) %}
<a class="item" href="{{ a.url | url }}">{% include "partials/item-art.njk" %}<span class="item-text"><span class="cat">{{ a.data.section | sectionName(sections) }}</span><span>{{ a.data.title }}</span></span></a>
{%- endfor %}
</section>
