---
layout: layouts/base.njk
pagination:
  data: sections
  size: 1
  alias: sec
permalink: "/{{ sec.key }}/"
eleventyComputed:
  title: "{{ sec.name }}"
---
<section class="list" style="margin-top:0"><h3>{{ sec.name }}</h3>
{%- set items = collections.articles | bySection(sec.key) %}
{%- for a in items %}
<a class="item" href="{{ a.url | url }}">{% include "partials/item-art.njk" %}<span>{{ a.data.title }}</span></a>
{%- else %}
<p class="item">Nothing here yet. Which is, frankly, suspicious.</p>
{%- endfor %}
</section>
